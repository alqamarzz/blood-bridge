// BloodBridge - Prisma Schema
// PostgreSQL with PostGIS for geospatial queries

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis]
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum RequestStatus {
  OPEN
  PARTIALLY_FILLED
  FULFILLED
  CANCELLED
  EXPIRED
}

enum UrgencyLevel {
  NORMAL
  URGENT
  CRITICAL
}

enum ResponseStatus {
  INTERESTED
  ACCEPTED
  IGNORED
  WITHDRAWN
  COMPLETED
}

enum NotificationType {
  NEW_REQUEST_NEARBY
  DONOR_VOLUNTEERED
  DONOR_ACCEPTED
  DONOR_IGNORED
  REQUEST_STATUS_CHANGED
  REQUEST_EXPIRED
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  WHATSAPP
  PUSH
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ReportReason {
  FAKE_REQUEST
  SPAM
  HARASSMENT
  INAPPROPRIATE
  SUSPICIOUS_ACTIVITY
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_SUSPENDED
  USER_REACTIVATED
  DONOR_PROFILE_CREATED
  DONOR_AVAILABILITY_CHANGED
  REQUEST_CREATED
  REQUEST_UPDATED
  REQUEST_CANCELLED
  REQUEST_FULFILLED
  REQUEST_EXPIRED
  DONOR_VOLUNTEERED
  DONOR_ACCEPTED
  DONOR_IGNORED
  DONOR_WITHDRAWN
  REPORT_CREATED
  REPORT_RESOLVED
  ADMIN_ACTION
}

// ─── Models ──────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String?   @unique
  phone         String    @unique
  passwordHash  String?
  role          UserRole  @default(USER)
  phoneVerified Boolean   @default(false)
  suspended     Boolean   @default(false)
  suspendedAt   DateTime?
  suspendReason String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  donorProfile    DonorProfile?
  bloodRequests   BloodRequest[]    @relation("RequesterRequests")
  donorResponses  DonorResponse[]
  notifications   Notification[]
  donationRecords DonationRecord[]
  reportsFiled    Report[]          @relation("ReporterReports")
  reportsReceived Report[]          @relation("ReportedUserReports")
  auditLogs       AuditLog[]
  sessions        Session[]
  accounts        Account[]

  @@index([phone])
  @@index([email])
  @@index([role])
  @@map("users")
}

// Auth.js models
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model DonorProfile {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @unique @db.Uuid
  bloodGroup      BloodGroup
  latitude        Float?
  longitude       Float?
  city            String     @default("Kolkata")
  area            String?
  pincode         String?
  preferredRadius Int        @default(5) // in km
  isAvailable     Boolean    @default(true)
  lastDonationDate DateTime?
  whatsappOptIn   Boolean    @default(false)
  pushOptIn       Boolean    @default(false)
  locationConsent Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bloodGroup])
  @@index([isAvailable])
  @@index([city])
  @@index([latitude, longitude])
  @@map("donor_profiles")
}

model BloodRequest {
  id                    String        @id @default(uuid()) @db.Uuid
  requesterId           String        @db.Uuid
  bloodGroup            BloodGroup
  unitsRequired         Int           @default(1)
  unitsFulfilled        Int           @default(0)
  hospitalName          String
  hospitalAddress       String
  latitude              Float?
  longitude             Float?
  city                  String        @default("Kolkata")
  requiredBy            DateTime
  urgency               UrgencyLevel  @default(NORMAL)
  additionalInformation String?
  contactPhone          String?
  status                RequestStatus @default(OPEN)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Relations
  requester       User              @relation("RequesterRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  donorResponses  DonorResponse[]
  notifications   Notification[]
  donationRecords DonationRecord[]
  reports         Report[]

  @@index([status])
  @@index([bloodGroup])
  @@index([requesterId])
  @@index([requiredBy])
  @@index([city])
  @@index([latitude, longitude])
  @@map("blood_requests")
}

model DonorResponse {
  id            String         @id @default(uuid()) @db.Uuid
  requestId     String         @db.Uuid
  donorId       String         @db.Uuid
  status        ResponseStatus @default(INTERESTED)
  statusMessage String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  request       BloodRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donor         User           @relation(fields: [donorId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([requestId, donorId]) // Prevent duplicate responses
  @@index([requestId])
  @@index([donorId])
  @@index([status])
  @@map("donor_responses")
}

model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  requestId         String?             @db.Uuid
  donorResponseId   String?             @db.Uuid
  type              NotificationType
  channel           NotificationChannel @default(IN_APP)
  title             String
  message           String
  deliveryStatus    DeliveryStatus      @default(PENDING)
  providerMessageId String?
  readAt            DateTime?
  sentAt            DateTime?
  metadata          Json?
  createdAt         DateTime            @default(now())

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  request       BloodRequest?  @relation(fields: [requestId], references: [id], onDelete: SetNull)
  donorResponse DonorResponse? @relation(fields: [donorResponseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, readAt])
  @@index([deliveryStatus])
  @@index([createdAt])
  @@map("notifications")
}

model DonationRecord {
  id                 String             @id @default(uuid()) @db.Uuid
  donorId            String             @db.Uuid
  requestId          String             @db.Uuid
  donationDate       DateTime?
  verificationStatus VerificationStatus @default(PENDING)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  donor   User         @relation(fields: [donorId], references: [id], onDelete: Cascade)
  request BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([donorId])
  @@index([requestId])
  @@map("donation_records")
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  reporterId     String       @db.Uuid
  reportedUserId String?      @db.Uuid
  requestId      String?      @db.Uuid
  reason         ReportReason
  description    String?
  status         ReportStatus @default(PENDING)
  adminNotes     String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  reporter     User          @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?         @relation("ReportedUserReports", fields: [reportedUserId], references: [id], onDelete: SetNull)
  request      BloodRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([reporterId])
  @@index([reportedUserId])
  @@map("reports")
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @db.Uuid
  action    AuditAction
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// OTP verification for phone-based auth
model OtpVerification {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
  @@map("otp_verifications")
}
